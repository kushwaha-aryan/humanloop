# ---------------------------------------------------------------------------
# HumanLoop environment configuration
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# `.env` is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Groq API key (https://console.groq.com/keys).
# Leave empty or unset to run the app in clearly-labelled Demo Mode.
GROQ_API_KEY=

# Model served through Groq's OpenAI-compatible API.
# Check https://console.groq.com/docs/models for models your account can use.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: override the API base URL (useful for self-hosted compatible gateways).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Port for the Express server (API + production build in one process).
PORT=3000

# Optional: upstream request timeout in milliseconds (default 30000).
AI_TIMEOUT_MS=30000
